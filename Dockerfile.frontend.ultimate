# BULLETPROOF FRONTEND - NEVER BREAKS FOR 100 YEARS
FROM node:18-alpine AS builder

# System deps
RUN apk add --no-cache curl git bash

WORKDIR /app

# Create bulletproof package.json
RUN cat > package.json << 'EOF'
{
  "name": "video-art-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "axios": "^1.6.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test"
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}
EOF

# Install with bulletproof strategy
RUN npm install --legacy-peer-deps --no-audit

# Copy ONLY source files that exist
COPY frontend/src /app/src
COPY frontend/public /app/public

# Create environment
RUN echo "REACT_APP_BACKEND_URL=http://localhost:8001" > .env
RUN echo "GENERATE_SOURCEMAP=false" >> .env

# Build with fallbacks
RUN npm run build || npx react-scripts build

# Production stage
FROM nginx:alpine
RUN apk add --no-cache curl
COPY --from=builder /app/build /usr/share/nginx/html

# Nginx config
RUN cat > /etc/nginx/conf.d/default.conf << 'EOF'
server {
    listen 3000;
    root /usr/share/nginx/html;
    index index.html;
    location / { try_files $uri $uri/ /index.html; }
    location /health { return 200 "OK"; add_header Content-Type text/plain; }
}
EOF

EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]